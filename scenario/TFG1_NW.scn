
00:00:00.00> PLUGINS LOAD savetraj
00:00:00.00> PLUGINS LOAD saveatmos
00:00:00.00> PLUGINS LOAD saveheader

00:00:00.00> CRE VLG1234, A320, 41.297, 2.078, 250, 5000, 250

# Definició global dels punts (recomanat)
00:00:05.00> DEFWPT SARRB, 41.65, -0.85, FIX
00:00:05.00> DEFWPT SIE, 41.05, -2.65, VOR

# Assignar la ruta a l'avió

00:00:06.00> ADDWPT VLG1234, SARRB
00:00:06.00> ADDWPT VLG1234, SIE
00:00:10.00> LNAV VLG1234, ON
00:00:10.00> ECHO VLG1234, Enlairament de Barcelona (LEBL)

# Pujada inicial
00:01:00.00> ALT VLG1234, 31000
00:05:00.00> VS VLG1234, 1500

# Canvi d'altitud durant el creuer (Baixada temporal)
00:20:00.00> ECHO VLG1234, Iniciant descens temporal a FL270
00:20:00.00> ALT VLG1234, 27000
00:20:00.00> VS VLG1234, -1000

# Tornada a l'altitud inicial de creuer
00:30:00.00> ECHO VLG1234, Tornant a FL310
00:30:00.00> ALT VLG1234, 31000
00:30:00.00> VS VLG1234, 1200

# Inici del descens final
00:45:00.00> ALT VLG1234, 10000
00:45:00.00> VS VLG1234, -2000

# Finalització
01:00:00.00> ECHO VLG1234, Arribada a Madrid (LEMD).
01:00:01.00> SAVETRAJ TFG1_Without_Wind
01:00:01.00> SAVEATMOS TFG1_Without_Wind_Atmos
01:00:01.00> SAVEHEADER TFG1_flight_header
01:00:15.00> DEL VLG1234
01:00:16.00> STOP
